# Copy this file to terraform.tfvars and update with your values
# terraform.tfvars is in .gitignore to protect sensitive information

resource_group_name = "rg-honeynet"
location            = "eastus"
project_name        = "honeynet"

# Network configuration
vnet_address_space    = "10.0.0.0/16"
subnet_address_prefix = "10.0.1.0/24"

# VM configuration
vm_size = "Standard_B2s" # Cost-effective: 2 vCPUs, 4GB RAM

# Security configuration
hardened  = false # Set to true after initial deployment to harden
admin_ip  = ""    # Your public IP for hardened mode (e.g., "1.2.3.4/32")

# Windows VM credentials
windows_admin_username = "azureadmin"
windows_admin_password = "YourSecurePassword123!" # Use Azure Key Vault in production

# Linux VM credentials
linux_admin_username  = "azureadmin"
linux_ssh_public_key  = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAAB..." # Your SSH public key

# Tags
tags = {
  Project     = "Honeynet"
  Environment = "Lab"
  ManagedBy   = "Terraform"
  CostCenter  = "Security"
}

